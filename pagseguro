<style>
/* ==========================================================================
   DESIGN SYSTEM : INSTITUTIONAL REPORT (DARK / CARD-BASED)
   ========================================================================== */
:root {
  --bg-main: #0c1017;
  --bg-surface: #151d2c;
  --bg-surface-elevated: #1c273a;
  --bg-surface-subtle: #0f1523;
  
  --border-subtle: #27354a;
  --border-strong: #3b4d68;
  --border-accent: #d4af37;
  
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  
  --color-positive: #16a34a;
  --color-positive-bg: rgba(22, 163, 74, 0.12);
  --color-negative: #dc2626;
  --color-negative-bg: rgba(220, 38, 38, 0.12);
  --color-warning: #ea580c;
  --color-warning-bg: rgba(234, 88, 12, 0.12);
  --color-accent: #d4af37;
  --color-accent-bg: rgba(212, 175, 55, 0.1);
  --color-info: #3b82f6;
  --color-info-bg: rgba(59, 130, 246, 0.12);
  
  --font-serif: "Charter", "Bitstream Charter", "Sitka Text", "Cambria", Georgia, serif;
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --font-mono: 'JetBrains Mono', "SF Mono", Menlo, Consolas, monospace;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  -webkit-print-color-adjust: exact !important;
  print-color-adjust: exact !important;
}

body {
  background-color: var(--bg-main);
  color: var(--text-secondary);
  font-family: var(--font-sans);
  font-size: 15.5px;
  line-height: 1.8;
  letter-spacing: -0.01em;
  padding: 0 0 100px 0;
  -webkit-font-smoothing: antialiased;
}

.report-wrapper {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ==========================================================================
   ACRONYM HOVER TOOLTIPS (INFOBULLES PURES CSS)
   ========================================================================== */
.acronym {
  position: relative;
  cursor: help;
  border-bottom: 1px dotted var(--color-accent);
  font-weight: 600;
  color: var(--text-primary);
  display: inline-block;
}

.acronym::after {
  content: attr(data-def);
  position: absolute;
  bottom: 130%;
  left: 50%;
  transform: translateX(-50%);
  background-color: #0b1120;
  color: #f8fafc;
  border: 1px solid var(--border-accent);
  padding: 6px 12px;
  border-radius: 4px;
  font-family: var(--font-sans);
  font-size: 12.5px;
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s ease, visibility 0.2s ease;
  z-index: 1000;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.6);
  pointer-events: none;
}

.acronym::before {
  content: "";
  position: absolute;
  bottom: 110%;
  left: 50%;
  transform: translateX(-50%);
  border-width: 5px;
  border-style: solid;
  border-color: var(--border-accent) transparent transparent transparent;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s ease, visibility 0.2s ease;
  z-index: 1000;
  pointer-events: none;
}

.acronym:hover::after,
.acronym:hover::before {
  opacity: 1;
  visibility: visible;
}

/* ==========================================================================
   INFOGRAPHIC CONTAINERS (IMAGES DU RAPPORT)
   ========================================================================== */
.infographic-box {
  margin: 24px 0 28px 0;
  border: 1px solid var(--border-subtle);
  border-radius: 8px;
  overflow: hidden;
  background-color: var(--bg-surface-subtle);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
  text-align: center;
}

.infographic-img {
  width: 100%;
  height: auto;
  display: block;
  margin: 0 auto;
}

.infographic-caption {
  font-family: var(--font-mono);
  font-size: 11.5px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 10px 16px;
  background-color: #111827;
  border-top: 1px solid var(--border-subtle);
  text-align: left;
}

/* ==========================================================================
   TYPOGRAPHY
   ========================================================================== */
h1, h2, h3, h4 {
  color: var(--text-primary);
  font-weight: 700;
  letter-spacing: -0.02em;
}

h1 {
  font-family: var(--font-serif);
  font-size: 36px;
  line-height: 1.25;
  margin-bottom: 16px;
}

h2.section-header {
  font-family: var(--font-serif);
  font-size: 24px;
  line-height: 1.3;
  color: var(--text-primary);
  margin-bottom: 20px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  gap: 12px;
}

h2.section-header::before {
  content: "";
  display: inline-block;
  width: 4px;
  height: 22px;
  background-color: var(--color-accent);
  border-radius: 2px;
}

h3.block-title {
  font-family: var(--font-sans);
  font-size: 17px;
  font-weight: 700;
  margin: 24px 0 14px 0;
  color: #e2e8f0;
  display: flex;
  align-items: center;
  gap: 8px;
}

h3.block-title::before {
  content: "▪";
  color: var(--color-accent);
}

p {
  margin-bottom: 16px;
  text-align: justify;
  font-size: 15.5px;
  color: var(--text-secondary);
}

p:last-child {
  margin-bottom: 0;
}

p strong, li strong {
  color: #ffffff;
  font-weight: 600;
}

/* Numbers Highlighting */
.num {
  font-family: var(--font-mono);
  font-size: 0.95em;
  color: #ffffff;
}

.num-neg {
  color: #f87171;
  font-weight: 700;
  font-family: var(--font-mono);
}

.num-pos {
  color: #4ade80;
  font-weight: 700;
  font-family: var(--font-mono);
}

.num-warn {
  color: #fb923c;
  font-weight: 700;
  font-family: var(--font-mono);
}

/* ==========================================================================
   HEADER / HERO
   ========================================================================== */
.report-header {
  background: linear-gradient(180deg, #111827 0%, var(--bg-main) 100%);
  border-bottom: 1px solid var(--border-subtle);
  padding: 40px 0 32px 0;
  margin-bottom: 36px;
}

.meta-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  padding-bottom: 14px;
  border-bottom: 1px solid rgba(51, 65, 85, 0.4);
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.meta-tags {
  display: flex;
  gap: 16px;
}

.meta-tag-item strong {
  color: var(--color-accent);
}

.hero-subtitle {
  font-family: var(--font-serif);
  font-size: 18px;
  line-height: 1.5;
  color: #cbd5e1;
  font-style: italic;
  margin-bottom: 24px;
}

.header-status-strip {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 16px;
  background-color: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-left: 4px solid var(--color-negative);
  padding: 16px 20px;
  border-radius: 6px;
}

.status-block-label {
  font-family: var(--font-mono);
  font-size: 11px;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 4px;
}

.status-block-value {
  font-family: var(--font-mono);
  font-size: 17px;
  font-weight: 700;
  color: var(--text-primary);
}

.status-block-value.destructive {
  color: #f87171;
}

/* ==========================================================================
   CONTENT CARDS & ENCADRÉS STRUCTURÉS
   ========================================================================== */
.content-card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 8px;
  padding: 32px 32px;
  margin-bottom: 32px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
}

.content-card-bordered-top {
  border-top: 4px solid var(--border-strong);
}

.content-card-accent {
  border-top: 4px solid var(--color-accent);
}

.analysis-box {
  background-color: var(--bg-surface-elevated);
  border: 1px solid var(--border-subtle);
  border-radius: 6px;
  padding: 20px 24px;
  margin: 18px 0 22px 0;
}

/* Encadré Pédagogique */
.plain-language-box {
  background-color: rgba(30, 41, 59, 0.85);
  border: 1px solid var(--border-strong);
  border-left: 4px solid var(--color-info);
  border-radius: 0 6px 6px 0;
  padding: 16px 20px;
  margin: 16px 0;
}

.plain-language-header {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--color-info);
  letter-spacing: 0.08em;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.plain-language-text {
  font-size: 14.5px;
  line-height: 1.6;
  color: #e2e8f0;
}

/* Verdict / Impact Actionnaire */
.verdict-mini-box {
  background-color: var(--bg-surface-subtle);
  border: 1px solid rgba(220, 38, 38, 0.3);
  border-left: 4px solid var(--color-negative);
  border-radius: 0 6px 6px 0;
  padding: 14px 18px;
  margin: 14px 0 20px 0;
}

.verdict-mini-header {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  color: #f87171;
  letter-spacing: 0.08em;
  margin-bottom: 4px;
}

.verdict-mini-text {
  font-size: 14px;
  line-height: 1.55;
  color: #fca5a5;
  font-weight: 500;
}

/* ==========================================================================
   EXECUTIVE SUMMARY : EN 30 SECONDES
   ========================================================================== */
.exec-summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 16px;
}

.exec-card {
  background-color: var(--bg-surface-elevated);
  border: 1px solid var(--border-subtle);
  padding: 16px 18px;
  border-radius: 6px;
}

.exec-card-title {
  font-family: var(--font-mono);
  font-size: 11px;
  text-transform: uppercase;
  color: var(--text-muted);
  letter-spacing: 0.05em;
  margin-bottom: 6px;
}

.exec-card-metric {
  font-family: var(--font-mono);
  font-size: 19px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.exec-card-desc {
  font-size: 12.5px;
  line-height: 1.45;
  color: var(--text-secondary);
}

.exec-dual-strip {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-top: 14px;
}

.exec-strip-item {
  background-color: var(--bg-surface-elevated);
  border: 1px solid var(--border-subtle);
  padding: 18px 20px;
  border-radius: 6px;
}

.exec-strip-item.positive-edge {
  border-left: 4px solid var(--color-positive);
}

.exec-strip-item.negative-edge {
  border-left: 4px solid var(--color-negative);
}

/* ==========================================================================
   FLASH KPI BANNER
   ========================================================================== */
.flash-kpi-container {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 32px;
}

.flash-kpi-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  padding: 20px;
  border-radius: 6px;
  border-top: 3px solid var(--color-accent);
}

.flash-kpi-name {
  font-family: var(--font-mono);
  font-size: 11px;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 8px;
}

.flash-kpi-value {
  font-family: var(--font-mono);
  font-size: 28px;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.1;
  margin-bottom: 6px;
}

.flash-kpi-sub {
  font-family: var(--font-mono);
  font-size: 12px;
  margin-bottom: 8px;
}

.flash-kpi-narrative {
  font-size: 12.5px;
  line-height: 1.4;
  color: var(--text-secondary);
}

/* ==========================================================================
   CUSTOM BULLETS & LISTS
   ========================================================================== */
ul.custom-bullets {
  list-style: none;
  margin: 12px 0;
  padding-left: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

ul.custom-bullets li {
  position: relative;
  padding-left: 22px;
  color: var(--text-secondary);
  font-size: 15px;
  text-align: justify;
}

ul.custom-bullets li::before {
  content: "—";
  position: absolute;
  left: 0;
  top: 0;
  color: var(--color-accent);
  font-family: var(--font-mono);
  font-weight: 700;
}

/* ==========================================================================
   BLOCKQUOTES & MANAGEMENT DECODING
   ========================================================================== */
.management-quote-block {
  margin: 22px 0;
  border-left: 3px solid var(--border-strong);
  background-color: var(--bg-surface-subtle);
  padding: 20px 24px;
  border-radius: 0 6px 6px 0;
}

blockquote {
  font-family: var(--font-serif);
  font-size: 16.5px;
  font-style: italic;
  line-height: 1.6;
  color: #e2e8f0;
  margin-bottom: 10px;
}

.quote-attribution {
  font-family: var(--font-mono);
  font-size: 11.5px;
  color: var(--color-accent);
  text-transform: uppercase;
  margin-bottom: 14px;
}

.decoding-container {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-left: 3px solid var(--color-negative);
  padding: 14px 18px;
  border-radius: 0 4px 4px 0;
}

.decoding-tag {
  font-family: var(--font-mono);
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--color-negative);
  letter-spacing: 0.08em;
  margin-bottom: 4px;
}

.decoding-text {
  font-size: 14px;
  line-height: 1.55;
  color: var(--text-secondary);
}

/* ==========================================================================
   EDITORIAL "À RETENIR" BOXES
   ========================================================================== */
.takeaway-box {
  background-color: var(--bg-surface-subtle);
  border: 1px solid var(--border-subtle);
  border-left: 3px solid var(--color-accent);
  padding: 16px 20px;
  margin-top: 24px;
  border-radius: 0 6px 6px 0;
}

.takeaway-label {
  font-family: var(--font-mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-accent);
  font-weight: 700;
  margin-bottom: 4px;
}

.takeaway-content {
  font-size: 14.5px;
  line-height: 1.55;
  color: #cbd5e1;
}

/* ==========================================================================
   DATA TABLES
   ========================================================================== */
.table-container {
  width: 100%;
  overflow-x: auto;
  margin: 20px 0 24px 0;
  border: 1px solid var(--border-subtle);
  border-radius: 6px;
  background-color: var(--bg-surface-elevated);
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
  text-align: left;
}

thead th {
  background-color: #121927;
  color: #cbd5e1;
  font-family: var(--font-mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 12px 14px;
  border-bottom: 1px solid var(--border-strong);
}

tbody td {
  padding: 12px 14px;
  border-bottom: 1px solid rgba(51, 65, 85, 0.4);
  color: var(--text-secondary);
}

tbody tr:last-child td {
  border-bottom: none;
}

tbody tr:hover td {
  background-color: rgba(255, 255, 255, 0.02);
}

.col-mono { font-family: var(--font-mono); }
.col-right { text-align: right; }
.col-center { text-align: center; }

/* ==========================================================================
   DIAGRAMS & CODE BLOCKS
   ========================================================================== */
.flow-diagram {
  background-color: var(--bg-surface-subtle);
  border: 1px solid var(--border-subtle);
  border-left: 3px solid var(--color-negative);
  border-radius: 6px;
  padding: 18px 20px;
  margin: 18px 0;
  font-family: var(--font-mono);
  font-size: 12.5px;
  line-height: 1.6;
  color: #cbd5e1;
  overflow-x: auto;
  white-space: pre;
}

/* ==========================================================================
   GRILLES (FLAGS & CHECKLIST)
   ========================================================================== */
.grid-2col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin: 20px 0;
}

.sub-box {
  background-color: var(--bg-surface-elevated);
  border: 1px solid var(--border-subtle);
  border-radius: 6px;
  padding: 20px;
}

.sub-box.positive-edge { border-top: 3px solid var(--color-positive); }
.sub-box.critical-edge { border-top: 3px solid var(--color-negative); }

.sub-box-title {
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 12px;
  letter-spacing: 0.05em;
}

.sub-box-title.positive { color: var(--color-positive); }
.sub-box-title.critical { color: var(--color-negative); }

.risk-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin: 20px 0;
}

.risk-card {
  background-color: var(--bg-surface-elevated);
  border: 1px solid var(--border-subtle);
  border-radius: 6px;
  padding: 18px;
}

.risk-card.level-critical { border-top: 3px solid var(--color-negative); }
.risk-card.level-important { border-top: 3px solid var(--color-warning); }

.risk-tag {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 2px 8px;
  border-radius: 3px;
  margin-bottom: 10px;
  font-weight: 700;
}

.risk-tag.critical { background-color: var(--color-negative-bg); color: #f87171; }
.risk-tag.warning { background-color: var(--color-warning-bg); color: #fb923c; }

.risk-title {
  font-size: 14.5px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6px;
}

.risk-text {
  font-size: 13px;
  line-height: 1.5;
  color: var(--text-secondary);
}

.risk-kpi-watch {
  margin-top: 10px;
  padding-top: 8px;
  border-top: 1px solid rgba(51, 65, 85, 0.4);
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-muted);
}

/* ==========================================================================
   FINAL VERDICT (CARD MAÎTRESSE)
   ========================================================================== */
.final-verdict-box {
  background-color: var(--bg-surface-subtle);
  border: 2px solid var(--color-negative);
  border-radius: 8px;
  padding: 36px;
  margin: 40px 0;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45);
}

.verdict-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border-subtle);
}

.verdict-decision-tag {
  font-family: var(--font-mono);
  font-size: 11px;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 4px;
}

.verdict-decision-main {
  font-family: var(--font-mono);
  font-size: 28px;
  font-weight: 800;
  color: #f87171;
}

.verdict-scores-strip {
  display: flex;
  gap: 32px;
}

.v-score-item {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.v-score-label {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-muted);
  text-transform: uppercase;
}

.v-score-val {
  font-family: var(--font-mono);
  font-size: 24px;
  font-weight: 800;
  color: var(--color-accent);
}

.verdict-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28px;
  margin-top: 20px;
}

.verdict-col h4 {
  font-family: var(--font-mono);
  font-size: 12.5px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 12px;
  padding-bottom: 6px;
  border-bottom: 1px solid var(--border-subtle);
}

.verdict-col.danger h4 { color: #f87171; }
.verdict-col.invalidation h4 { color: var(--color-accent); }

.verdict-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.verdict-list li {
  font-size: 14px;
  line-height: 1.5;
  padding-left: 18px;
  position: relative;
}

.verdict-list.danger-list li::before {
  content: "×";
  position: absolute;
  left: 0;
  top: 0;
  color: #f87171;
  font-weight: 700;
  font-family: var(--font-mono);
}

.verdict-list.invalidation-list li::before {
  content: "→";
  position: absolute;
  left: 0;
  top: 0;
  color: var(--color-accent);
  font-weight: 700;
  font-family: var(--font-mono);
}

/* ==========================================================================
   RESPONSIVE
   ========================================================================== */
